{
  "name": "iobroker.rpi-io",
  "version": "0.0.1",
  "description": "iobroker io adapter for raspberry pi",
  "author": {
    "name": "Albert Salai",
    "email": "albert2013@salai.de"
  },
  "homepage": "https://github.com/albert-salai/ioBroker.rpi-io",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "template",
    "Smart Home",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:albert-salai/ioBroker.rpi-io.git"
  },
  "engines": {
    "node": ">= 24"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/types": "^7.2.5",
    "async-mutex": "^0.5.0",
    "debounce": "^3.0.0",
    "deep-diff": "^1.0.2",
    "i2c-bus": "^5.2.3",
    "rpio": "^2.4.2",
    "sprintf-js": "^1.1.3"
  },
  "devDependencies": {
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/deep-diff": "^1.0.5",
    "@types/i2c-bus": "^5.1.2",
    "@types/iobroker": "npm:@iobroker/types@^7.2.5",
    "@types/node": "^24.19.2",
    "@types/rpio": "^2.4.6",
    "@types/sprintf-js": "^1.1.4",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "test -d build || npm run build",
    "prebuild": "rimraf build",
    "build": "build-adapter ts",
    "watch": "build-adapter ts --watch",
    "prebuild:ts": "rimraf build",
    "build:ts": "build-adapter ts",
    "watch:ts": "build-adapter ts --watch",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "verify": "npm run check && npm run lint && npm run build && npm test"
  },
  "bugs": {
    "url": "https://github.com/albert-salai/ioBroker.rpi-io/issues"
  },
  "readmeFilename": "README.md"
}
